OPENAI_API_KEY=

# Option A: single URL (recommended for Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workwise

# Option B: separate DB variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=workwise

FRONTEND_ORIGIN=http://localhost:3000

# Protects IA regeneration and admin operations
ADMIN_TOKEN=cambia-esto-en-produccion

# Modelo para el asistente de CV (opcional)
OPENAI_CV_MODEL=gpt-4o-mini
